# GSTACK configuration (Section 11). Copy to .env and fill in. No secrets in code.

# --- Required for live odds ---
ODDS_API_KEY=

# --- Required for staking (recommendations) ---
BANKROLL=1000
MAX_STAKE_PER_BET=100

# --- Sport / markets (safe defaults shown) ---
# SPORT=NBA uses sportsbooks; SPORT=SOCCER_WC uses Kalshi via `gstack poll-wc`.
SPORT=NBA
ODDS_API_SPORT_KEY=basketball_nba
MARKETS=h2h,spreads,totals
ODDS_API_REGIONS=us

# --- Books ---
SHARP_BOOK=pinnacle
SOFT_BOOKS=draftkings,fanduel,betmgm,espnbet

# --- Kalshi (World Cup execution venue; free API, NOT budgeted) ---
KALSHI_SERIES_TICKER=KXWORLDCUP
KALSHI_MAKER=false          # true = price at the bid (fee-free); false = taker
KALSHI_FEE_COEFF=0.07       # Kalshi fee = coeff*price*(1-price); verify vs live schedule

# --- Budget / math ---
REQUEST_BUDGET=450
EV_THRESHOLD=0.03
KELLY_MULTIPLIER=0.25

# --- Storage ---
DB_URL=sqlite:///gstack.db

# --- Telegram alerts (optional in free phase) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Phase 3 (reserved) ---
LLM_API_KEY=
LLM_MONTHLY_CAP_USD=
